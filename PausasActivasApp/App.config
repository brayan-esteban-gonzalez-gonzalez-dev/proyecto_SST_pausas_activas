<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!-- ═══════════════════════════════════════════════════════
       Cadena de conexión — SQL Server Express
       Autenticación de Windows (Integrated Security=True)
       TrustServerCertificate=True requerido en .NET 8
       ═══════════════════════════════════════════════════════ -->
  <connectionStrings>
    <add name="PausasActivasDB"
         connectionString="Server=localhost;Database=PausasActivasDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

</configuration>
