<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PausasActivasApp</AssemblyName>
    <RootNamespace>PausasActivasApp</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- ══════════════════════════════════════════════════════
       Paquete NuGet: Microsoft.Data.SqlClient (ADO.NET moderno
       compatible con .NET 8). Solo este paquete; sin ORM.
       ══════════════════════════════════════════════════════ -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!-- ══════════════════════════════════════════════════════
       App.config: se copia al directorio de salida.
       ══════════════════════════════════════════════════════ -->
  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ══════════════════════════════════════════════════════
       Recursos de imágenes: se copian al directorio de salida
       manteniendo la estructura de carpetas.
       ══════════════════════════════════════════════════════ -->
  <ItemGroup>
    <Content Include="Recursos\Imagenes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ══════════════════════════════════════════════════════
       Formularios WinForms: declaración explícita para que
       el SDK encuentre los .resx y los .Designer.cs
       ══════════════════════════════════════════════════════ -->
  <ItemGroup>
    <Compile Update="Formularios\FrmLogin.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmLogin.Designer.cs">
      <DependentUpon>FrmLogin.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Formularios\FrmLogin.resx">
      <DependentUpon>FrmLogin.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Formularios\Admin\FrmAdminPrincipal.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\Admin\FrmAdminPrincipal.Designer.cs">
